{
    "name": "wiseadmin/wise-operation-log",
    "description": "WiseAdmin 操作日志扩展包 — 基于 PHP 8 Attribute 的声明式操作日志记录，支持敏感数据脱敏、异常检测与自动归档",
    "homepage": "https://github.com/hiwiseadmin/wise-operation-log",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "WiseAdmin Team",
            "email": "wiseadmin@126.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^6.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "wise\\operationlog\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "think": {
            "services": [
                "wise\\operationlog\\Service"
            ],
            "config": {
                "wise-operation-log": "config/wise-operation-log.php"
            },
            "migrate-path": "database/migrations"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/docs",
            "/.github",
            "/phpunit.xml",
            "/.gitattributes",
            "/.gitignore",
            "/*.md",
            "!/README.md",
            "/qa/"
        ]
    }
}
